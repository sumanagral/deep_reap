{
  "title": "DeepREAP Overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "REAP predictions / sec (cpu_load)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "rate(deepreap_reap_predictions_total{target=\"cpu_load\"}[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Scheduling decisions / sec",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(deepreap_scheduler_decisions_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "REAP latency p50 / p95 (s)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(deepreap_reap_latency_seconds_bucket[1m])) by (le, target))",
          "legendFormat": "p50 {{target}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(deepreap_reap_latency_seconds_bucket[1m])) by (le, target))",
          "legendFormat": "p95 {{target}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Predicted value (latest)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "deepreap_reap_predicted_value",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "REAP observed abs error",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "deepreap_reap_observed_error",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scheduler latency p95 (s)",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(deepreap_scheduler_latency_seconds_bucket[1m])) by (le))",
          "refId": "A"
        }
      ]
    }
  ]
}
